{
  "version": 2,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.tailwindcss.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'none';" }
      ]
    },
    {
      "source": "/sitemap-final.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/sitemap-final.xml", "destination": "/sitemap-final.xml" },
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/certificates/:path*", "destination": "/certificates/:path*" },
    { "source": "/((?!sitemap-final\\.xml|robots\\.txt|certificates/).*)", "destination": "/index.html" }
  ]
}